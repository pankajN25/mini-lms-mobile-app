# ─────────────────────────────────────────
# MiniLMS – Environment Variables


# Public API base URL (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=https://api.freeapi.app

EXPO_PUBLIC_APP_VERSION=1.0.0


EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here


EXPO_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here

# ─────────────────────────────────────────
# Notes:
# • Variables prefixed with EXPO_PUBLIC_ are bundled into the JS bundle.
#   Do NOT put secrets here.
# • Sensitive tokens (auth tokens, API keys) are stored in Expo SecureStore
#   at runtime — never in .env files.
# • For EAS builds set secrets via: eas secret:create
# ─────────────────────────────────────────
